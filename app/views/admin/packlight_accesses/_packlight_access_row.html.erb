<tr id="<%= dom_id(packlight_access) %>" class="border-b hover:bg-slate-50">
  <td class="px-6 py-4 text-slate-800 font-medium"><%= packlight_access.email %></td>
  <td class="px-6 py-4 text-slate-600"><%= time_ago_in_words(packlight_access.created_at) %> ago</td>
  <td class="px-6 py-4">
    <% if User.exists?(email: packlight_access.email) %>
      <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800">Signed up</span>
    <% else %>
      <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold bg-slate-100 text-slate-800">Invited</span>
    <% end %>
  </td>
  <td class="px-6 py-4 text-sm font-medium">
    <%= button_to "Revoke",
      admin_packlight_access_path(packlight_access),
      method: :delete,
      form: { data: { turbo_confirm: "Revoke access for #{packlight_access.email}?" } },
      class: "text-red-600 hover:text-red-900 font-semibold cursor-pointer bg-transparent border-0 p-0" %>
  </td>
</tr>
