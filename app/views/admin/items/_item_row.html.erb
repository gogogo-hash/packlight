<tr id="<%= dom_id(item) %>" class="border-b hover:bg-slate-50">
  <td class="px-6 py-4 text-slate-800 font-medium">
    <% display_name = item.name.presence || item.file_folder_path&.split("/")&.last || "Untitled" %>
    <%= link_to display_name,
    packlight_item_path(packlight_id: item.admin.packlight_id, id: item.id),
    class: "text-slate-800 font-semibold hover:text-indigo-600 transition-colors duration-150", data: { turbo: false } %>
  </td>
  <td class="px-6 py-4">
    <% case item.status %>
      <% when "processed" %>
        <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800">Processed</span>
      <% when "pending" %>
        <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold bg-yellow-100 text-yellow-800">Pending</span>
      <% when "error" %>
        <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold bg-red-100 text-red-800">Error</span>
      <% when "sold" %>
        <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold bg-slate-200 text-slate-700">Sold</span>
      <% else %>
        <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold bg-slate-100 text-slate-800">Unknown</span>
    <% end %>
  </td>
  <td class="px-6 py-4 text-slate-800">
    <% if item.price %>
      $<%= number_with_precision(item.price, precision: 2) %>
    <% else %>
      —
    <% end %>
  </td>
  <td class="px-6 py-4 text-sm font-medium space-x-3 whitespace-nowrap">
    <%= link_to "Edit",
      edit_admin_item_path(item),
      data: { turbo_frame: "modal" },
      class: "text-indigo-600 hover:text-indigo-900 font-semibold" %>
    <% unless item.status == "sold" %>
      <%= button_to "Mark Sold",
        mark_sold_admin_item_path(item),
        method: :patch,
        form_class: "inline-block",
        class: "text-emerald-600 hover:text-emerald-900 font-semibold cursor-pointer" %>
    <% end %>
    <%= button_to "Delete",
      admin_item_path(item),
      method: :delete,
      form_class: "inline-block",
      data: { turbo_confirm: "Delete this item? This cannot be undone." },
      class: "text-red-600 hover:text-red-900 font-semibold cursor-pointer" %>
  </td>
</tr>