<div class="px-2 sm:px-6 w-full">
  <div class="max-w-6xl mx-auto px-4 py-8">

    <div class="mb-2 mt-4">
      <%= link_to admin_items_path, class: "group inline-flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 transition-transform group-hover:-translate-x-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
        Back to items
      <% end %>
    </div>

    <div class="mb-6">
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl mb-2">
        Create Item
      </h2>
      <p class="text-sm sm:text-base text-slate-500 max-w-2xl leading-relaxed">
        Upload one or more photos. AI will generate the title, description, and price.
      </p>
    </div>

    <%= form_with url: admin_items_path, method: :post, multipart: true, local: true, class: "flex flex-col gap-4 max-w-xs" do |f| %>
      <div>
        <%= label_tag :photos, "Photos", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= file_field_tag "photos[]", multiple: true, accept: "image/*",
              class: "w-full bg-white text-slate-800 border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:outline-none p-2 rounded" %>
      </div>

      <%= submit_tag "Upload & Process with AI",
            class: "w-full bg-[#0E4450] hover:bg-[#646C5E] text-white font-semibold py-2 px-4 rounded-sm transition duration-200 cursor-pointer" %>
    <% end %>

  </div>
</div>
