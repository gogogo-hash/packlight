<%= link_to packlight_item_path(packlight_id: item.admin.packlight_id, id: item.id), class: "group" do %>
  <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition flex">
    <div class="w-1/3 flex-shrink-0 bg-white flex items-center justify-center overflow-hidden h-40 py-[10px] px-[15px]">
      <% if item.thumbnail %>
        <img src="data:image/jpeg;base64,<%= Base64.strict_encode64(item.thumbnail) %>"
             alt="<%= item.name %>"
             class="w-full h-full object-cover rounded-[12px] group-hover:scale-105 transition">
      <% else %>
        <div class="text-slate-400 text-xs">No image</div>
      <% end %>
    </div>
    <div class="p-3 flex flex-col justify-center">
      <h3 class="text-[16px] font-semibold text-slate-800 line-clamp-2"><%= item.name %></h3>
      <h3 class="text-[14px] text-slate-600 line-clamp-2"><%= item.description %></h3>
      <h3 class="text-[14px] text-slate-600 line-clamp-2"><%= time_ago_in_words(item.created_at) %> ago</h3>


      <p class="text-[16px] font-semibold text-[#F1AF16] mt-1">$<%= number_with_precision(item.price, precision: 2) %></p>
    </div>
  </div>
<% end %>
