<div class="min-h-screen">
  <div class="max-w-7xl mx-auto px-4 py-4">

    <!-- Search -->
    <div class="mb-10">
      <%= form_with url: communities_path, method: :get, local: true, class: "flex gap-2 max-w-xl mx-auto" do %>
        <input type="text" name="q" value="<%= params[:q] %>"
               placeholder="Search listings..."
               class="flex-1 bg-white text-slate-800 placeholder:text-slate-500 border border-slate-300 rounded-sm px-4 py-2 text-sm focus:ring-2 focus:ring-[#0E4450] focus:outline-none">
        <%= button_tag "Search", type: "submit",
              class: "bg-[#0E4450] hover:bg-[#646C5E] text-white text-sm font-semibold px-4 py-2 rounded-sm transition duration-200" %>
      <% end %>
    </div>

    <!-- Search Results -->
    <% if params[:q].present? %>
      <section class="mb-12">
        <h2 class="text-[32px] font-semibold text-slate-800 mb-4">Search Results for &ldquo;<%= params[:q] %>&rdquo;</h2>

        <% if @search_results.present? %>
          <div class="grid grid-cols-2 lg:grid-cols-2 gap-4">
            <%= render partial: "item_card", collection: @search_results, as: :item %>
          </div>
        <% else %>
          <div class="text-center py-8 bg-white rounded-lg shadow-sm">
            <p class="text-slate-500 text-sm">No listings match &ldquo;<%= params[:q] %>&rdquo;.</p>
          </div>
        <% end %>
      </section>
    <% end %>

    <!-- Recent Listings feed -->
    <section class="mb-12">
      <h2 class="text-[32px] font-semibold text-slate-800 mb-4">Recent Listings</h2>

      <% if @recent_items.present? && @recent_items.any? %>
        <div class="grid grid-cols-2 lg:grid-cols-2 gap-4">
          <%= render partial: "item_card", collection: @recent_items, as: :item %>
        </div>
      <% else %>
        <div class="text-center py-8 bg-white rounded-lg shadow-sm">
          <p class="text-slate-500 text-sm">No listings yet. New items will show up here as your communities add them.</p>
        </div>
      <% end %>
    </section>

    <!-- Communities -->
    <section>
      <h2 class="text-[32px] font-semibold text-slate-800 mb-4">Communities</h2>

      <% if @users.any? %>
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
          <% @users.each do |user| %>
            <% if user.packlight_id %>
              <%= link_to packlight_page_path(packlight_id: user.packlight_id), class: "group block" do %>
                <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition h-32 flex items-center justify-center p-4">
                  <span class="text-[13px] font-semibold text-slate-800 text-center line-clamp-2 group-hover:underline">
                    <%= user.email.split("@").first.capitalize %>'s Packlight
                  </span>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-12">
          <p class="text-slate-600 text-lg">You have not been invited to see any Packlight collections yet.</p>
        </div>
      <% end %>
    </section>

  </div>
</div>
