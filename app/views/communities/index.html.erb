<div class="min-h-screen">
  <div class="max-w-7xl mx-auto px-4 py-4">

    <!-- Search -->
    <div class="mb-10">
      <%= form_with url: communities_path, method: :get, local: true, class: "flex gap-2 max-w-xl mx-auto" do %>
        <input type="text" name="q" value="<%= params[:q] %>"
               placeholder="Search listings..."
               class="flex-1 h-[50px] bg-white text-slate-800 placeholder:text-slate-500 border border-slate-300 rounded-sm px-4 text-[16px] focus:ring-2 focus:ring-[#0E4450] focus:outline-none">
        <%= button_tag "Search", type: "submit",
              class: "bg-[#0E4450] hover:bg-[#646C5E] text-white text-sm font-semibold px-4 py-2 rounded-sm transition duration-200" %>
      <% end %>
    </div>

    <!-- Search Results -->
    <% if params[:q].present? %>
      <section class="mb-12">
        <h2 class="text-[32px] font-semibold text-slate-800 mb-4">Search Results for &ldquo;<%= params[:q] %>&rdquo;</h2>

        <% if @search_results.present? %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <%= render partial: "item_card", collection: @search_results, as: :item %>
          </div>
        <% else %>
          <div class="text-center py-8 bg-white rounded-lg shadow-sm">
            <p class="text-slate-500 text-sm px-4">No listings match &ldquo;<%= params[:q] %>&rdquo;.</p>
          </div>
        <% end %>
      </section>
    <% end %>

    <!-- Recent Listings feed -->
    <section class="mb-12">
      <h2 class="text-[32px] font-semibold text-slate-800 mb-4">Recent Listings</h2>

      <% if @recent_items.present? && @recent_items.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= render partial: "item_card", collection: @recent_items, as: :item %>
        </div>
      <% else %>
        <div class="text-center py-8 bg-white rounded-lg shadow-sm">
          <p class="text-slate-500 text-sm px-4">Recent items will show up here as your communities add them.</p>
        </div>
      <% end %>
    </section>

    <!-- Watch Listings feed -->
    <section id="watch-list" class="mb-12">
      <h2 class="text-[32px] font-semibold text-slate-800 mb-4">Watch List</h2>

      <% if @watched_items.present? && @watched_items.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= render partial: "item_card", collection: @watched_items, as: :item %>
        </div>

        <% if @pagy.pages > 1 %>
          <div class="flex justify-center items-center gap-4 mt-4">
            <% if @pagy.prev %>
              <%= link_to "Previous", communities_path(page: @pagy.prev, anchor: "watch-list"), class: "bg-[#0E4450] hover:bg-[#646C5E] text-white text-sm font-semibold px-4 py-2 rounded-sm transition duration-200" %>
            <% else %>
              <span class="bg-slate-200 text-slate-400 text-sm font-semibold px-4 py-2 rounded-sm cursor-not-allowed">Previous</span>
            <% end %>

            <span class="text-sm text-slate-600">Page <%= @pagy.page %> of <%= @pagy.pages %></span>

            <% if @pagy.next %>
              <%= link_to "Next", communities_path(page: @pagy.next, anchor: "watch-list"), class: "bg-[#0E4450] hover:bg-[#646C5E] text-white text-sm font-semibold px-4 py-2 rounded-sm transition duration-200" %>
            <% else %>
              <span class="bg-slate-200 text-slate-400 text-sm font-semibold px-4 py-2 rounded-sm cursor-not-allowed">Next</span>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-8 bg-white rounded-lg shadow-sm">
          <p class="text-slate-500 text-sm px-4">You haven't added any items to your watch list yet.</p>
        </div>
      <% end %>
    </section>

    <!-- Communities -->
    <section>
      <h2 class="text-[32px] font-semibold text-slate-800 mb-4">Communities</h2>

      <% if @users.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= render partial: "user_card", collection: @users.select(&:packlight_id), as: :user %>
        </div>
      <% else %>
        <div class="text-center py-8 bg-white rounded-lg shadow-sm">
          <p class="text-slate-500 text-sm px-4">You have not been invited to see any Packlight collections yet.</p>
        </div>
      <% end %>
    </section>

    <!-- Public Communities -->
    <section class="mt-12">
      <h2 class="text-[32px] font-semibold text-slate-800 mb-4">Public Communities</h2>

      <% if @public_users.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= render partial: "user_card", collection: @public_users.select(&:packlight_id), as: :user %>
        </div>
      <% else %>
        <div class="text-center py-8 bg-white rounded-lg shadow-sm">
          <p class="text-slate-500 text-sm px-4">No public Packlight collections yet.</p>
        </div>
      <% end %>
    </section>

  </div>
</div>
